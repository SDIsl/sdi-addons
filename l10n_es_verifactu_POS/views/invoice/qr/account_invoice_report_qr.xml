<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="invoice_qr_right_of_logo_v11" inherit_id="web.external_layout_standard">
    <xpath expr="//div[hasclass('row') and descendant::img[contains(@t-att-src, 'company.logo')]]"
           position="replace">
      <div class="row"
           style="margin-bottom:10px; display:flex; justify-content:space-between; align-items:flex-start;">

        <!-- Logo a la izquierda -->
        <div style="flex:1; text-align:left;">
          <img t-if="company.logo"
               t-att-src="'/web/image/res.company/%s/logo' % company.id"
               style="max-height:45px; object-fit:contain;"/>
        </div>

        <!-- QR a la derecha (solo ventas/abonos) -->
        <t t-if="o and o._name == 'account.invoice' and o.type in ('out_invoice','out_refund') and o.verifactu_qr_image">
          <div style="flex:0 0 auto; text-align:center; margin-left:12px;">
            <div style="font-weight:bold; font-size:10pt; margin-bottom:2px;">QR tributario:</div>
            <!-- servir el binario mediante /web/image -->
            <img t-att-src="'/web/image/%s/%s/verifactu_qr_image' % (o._name, o.id)"
                 style="width:40mm; height:40mm; border:1px solid #ccc; padding:5px; background-color:#fff;"/>
            <t t-if="o.verifactu_status not in ('error','rejected','pending')">
              <div style="font-weight:bold; margin-top:4px;">VERI*FACTU</div>
            </t>
          </div>
        </t>

      </div>
    </xpath>
  </template>
</odoo>
